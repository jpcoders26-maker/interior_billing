# Copy to .env for local development (npm run dev) and fill in real values
# for anything beyond a local Postgres. Never commit the real .env file —
# see docs/DEPLOYMENT.md for production environment variables and
# docs/DATABASE.md for the Postgres setup this points at.

# Postgres connection string (see docs/DATABASE.md for how to create this
# role/database in a local PostgreSQL install — no Docker needed).
DATABASE_URL="postgresql://teakworks:teakworks_dev_password@localhost:5432/furniture_db?schema=public"

# JWT signing secret for session cookies (src/lib/server/jwt.ts). Required in
# production — the app refuses to sign/verify tokens without it there.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-secure-random-value-at-least-32-chars"

# Redis, used for distributed rate limiting (src/lib/server/rate-limit.ts).
# Leave unset in development — it falls back to an in-memory limiter (see
# SECURITY.md §9). Required in any multi-instance/production deployment.
# REDIS_URL="redis://localhost:6379"

# Shown on the pre-login screen and browser tab title before company data
# has loaded (see README "Company logo & branding").
NEXT_PUBLIC_APP_NAME="Teakworks"
