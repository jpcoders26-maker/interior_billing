generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  emailVerified DateTime?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignedLeads Lead[]
  managedProjects Project[]
}

model Lead {
  id             String   @id @default(cuid())
  name           String
  phone          String
  enquiryDate    DateTime @default(now())
  source         String?
  siteLocation   String?
  workRequired   String?
  estimatedBudget Float?
  expectedStart  DateTime?
  assignedToId   String? 
  assignedTo     User?    @relation(fields: [assignedToId], references: [id])
  followupDate   DateTime?
  status         String   @default("New")
  notes          String?
  createdAt      DateTime @default(now())
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  mobile       String?
  whatsapp     String?
  email        String?
  billingAddress String?
  siteAddress  String?
  gstNumber    String?
  panNumber    String?
  customerType String?
  notes        String?
  createdAt    DateTime @default(now())
  projects     Project[]
  quotations   Quotation[]
  invoices     Invoice[]
}

model Project {
  id           String   @id @default(cuid())
  name         String
  siteAddress  String?
  startDate    DateTime?
  expectedCompletion DateTime?
  managerId    String?
  manager      User?    @relation(fields: [managerId], references: [id])
  contractValue Float?
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  workCategories WorkCategory[]
  materials    ProjectMaterial[]
  expenses     Expense[]
  invoices     Invoice[]
  quotations   Quotation[]
  purchases    Purchase[]
  createdAt    DateTime @default(now())
}

model WorkCategory {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  name      String
  description String?
  contractValue Float?
  progress  Int     @default(0)
}

model Quotation {
  id         String @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  title      String
  version    Int     @default(1)
  status     String  @default("Draft")
  items      QuotationItem[]
  subtotal   Float? 
  discount   Float? 
  gst        Float? 
  total      Float? 
  createdAt  DateTime @default(now())
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  description String
  qty         Float   @default(1)
  unit        String?
  rate        Float
  amount      Float
  category    String?
}

model Invoice {
  id         String @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  invoiceNumber String @unique
  date       DateTime @default(now())
  dueDate    DateTime?
  amount     Float
  paidAmount Float  @default(0)
  status     String @default("Unpaid")
  payments   Payment[]
}

model Payment {
  id        String @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  date      DateTime @default(now())
  amount    Float
  method    String
  reference String?
}

model Expense {
  id        String @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  category  String
  amount    Float
  date      DateTime @default(now())
  notes     String?
}

model Material {
  id        String @id @default(cuid())
  name      String
  unit      String
  sku       String?
  createdAt DateTime @default(now())
  purchases Purchase[]
  projectMaterials ProjectMaterial[]
}

model Purchase {
  id         String @id @default(cuid())
  supplier   String
  invoiceNo  String?
  date       DateTime @default(now())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  qty        Float
  rate       Float
  gst        Float?
  total      Float
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
}

model ProjectMaterial {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  materialId String
  material  Material @relation(fields: [materialId], references: [id])
  qtyUsed   Float
  wastage   Float?
}

// Add indexes or other models as needed
